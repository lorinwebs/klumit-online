# Copy to .env.local and fill in real values:
#   cp .env.example .env.local

# Supabase (required for auth + chat)
# Dashboard: https://supabase.com/dashboard/project/ddpdhsgnxmhvrcbphhcv/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://ddpdhsgnxmhvrcbphhcv.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Shopify Storefront
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Grow payments via the Grow app for Make (see GROW_INTEGRATION.md)
# Scenario "KLUMIT · Grow payment link": Custom webhook → Router by `event`
#   create_payment_link → Grow: Create Payment Link → Webhook response
#   get_payment_link_info → Grow: Get Payment Link Info → Webhook response (verification)
# Both variables point at the same Custom webhook address.
MAKE_GROW_CREATE_LINK_WEBHOOK_URL=https://hook.eu1.make.com/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MAKE_GROW_LINK_INFO_WEBHOOK_URL=https://hook.eu1.make.com/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Shared secret (openssl rand -hex 32): sent by the site to Make and by Make back to /api/grow/webhook
MAKE_WEBHOOK_SECRET=
# Scenario "KLUMIT · Grow notify": address of the "Grow: Notify URL Webhook" trigger
# (optional – the Create Payment Link module has it hard-coded as a fallback)
MAKE_GROW_NOTIFY_WEBHOOK_URL=
# redirect (default) | iframe – Grow payment pages can only be framed on grow.website
GROW_OPEN_MODE=redirect
# Sent to Make as maxPayments; the Make "Create Payment Link" module is fixed to a single payment
GROW_MAX_PAYMENTS=1

# Optional
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_tPFMEzPdLjzuNPUzpAoxdQxuiXMZiTVhDEMn8dp6tBSr
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
